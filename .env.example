RH_CHAIN_ID=4663
# Primary RPC (recommended: Alchemy free tier — stable, dedicated quota).
# Create an app at https://dashboard.alchemy.com (Robinhood Chain) and paste your key.
RH_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Fallbacks are hardcoded in src/lib/public-client.ts:
#   1. https://robinhood-rpc.publicnode.com
#   2. https://rpc.mainnet.chain.robinhood.com
# Used automatically when the primary fails (rate limit, timeout, outage).
RH_DATA_DIR=data
RH_MAX_SNAPSHOTS=200
# --- BSC (PancakeSwap v3) ---
# Override the primary BSC RPC; otherwise public fallbacks in src/lib/bsc-public-client.ts are used.
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# Archive-capable BSC RPC for NFT mint-time lookups (position age).
# Required for the Age column on BSC: free public RPCs block the wide eth_getLogs ranges.
# Create a free BSC app at https://dashboard.alchemy.com and paste its RPC URL:
# BSC_ARCHIVE_RPC_URL=https://bsc-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BSC_CHAIN_ID=56
WALLET_ADDRESS=0x0000000000000000000000000000000000000000